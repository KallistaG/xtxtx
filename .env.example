# Google AI Studio / Gemini API key (image generation)
GEMINI_API_KEY=
# Model with image output enabled for your account; update when models change
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Meta Page publishing (only needed for --post / scheduled publishing)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v23.0

# Daily scheduler uses local timezone unless configured
POST_TIME=09:00
TIMEZONE=Asia/Manila
# Explicit opt-in required for scheduler to publish instead of dry-run
ENABLE_AUTO_POST=false
OUTPUT_DIR=output
